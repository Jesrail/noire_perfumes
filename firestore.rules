rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    // The admin site's account: verified email match (or the admin custom claim
    // set by the claimInitialAdmin Cloud Function).
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email == 'reenyearjunior@gmail.com'
          && request.auth.token.email_verified == true)
        || request.auth.token.admin == true
      );
    }

    function notBlocked() {
      let ref = /databases/$(database)/documents/blockedUsers/$(request.auth.uid);
      return !(exists(ref) && get(ref).data.blocked == true);
    }

    // ---------- products ----------
    // Shop: anyone can browse. Admin site: full control.
    // Shop checkout may ONLY lower the stock number (never raise it, never edit other fields).
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
      );
    }

    // ---------- orders ----------
    // Customers create and read their own orders; only the admin site changes status.
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn() && notBlocked()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'To Ship'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number;

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'Completed'
        && !('rating' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
      );

      allow delete: if isAdmin();
    }

    // ---------- carts (private to each customer) ----------
    match /carts/{userId}/items/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ---------- customer profiles ----------
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || resource.data.email == request.auth.token.email
        || isAdmin()
      );
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ---------- contact form -> admin inbox ----------
    match /messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'unread';
      allow read, update, delete: if isAdmin();
    }

    // ---------- written only by Cloud Functions (admin SDK bypasses rules) ----------
    match /blockedUsers/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
